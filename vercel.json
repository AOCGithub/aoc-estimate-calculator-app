{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist/client",
  "redirects": [
    { "source": "/", "has": [{ "type": "host", "value": "aoc-estimate-calculator.vercel.app" }], "destination": "https://estimate.alwaysopencommerce.com/", "permanent": false },
    { "source": "/", "has": [{ "type": "host", "value": "aoc-estimate-calculator-aocs-projects-b933e3ab.vercel.app" }], "destination": "https://estimate.alwaysopencommerce.com/", "permanent": false },
    { "source": "/", "has": [{ "type": "host", "value": "aoc-estimate-calculator-git-main-aocs-projects-b933e3ab.vercel.app" }], "destination": "https://estimate.alwaysopencommerce.com/", "permanent": false }
  ],
  "crons": [{ "path": "/api/client-profile/cleanup", "schedule": "0 3 * * *" }],
  "functions": {
    "api/client-profile.mjs": { "maxDuration": 30 },
    "api/client-profile/status.mjs": { "maxDuration": 20 },
    "api/client-profile/cleanup.mjs": { "maxDuration": 20 },
    "api/journey/analyze.mjs": { "maxDuration": 60 },
    "api/voice/session.mjs": { "maxDuration": 60 },
    "api/journey/correct.mjs": { "maxDuration": 60 },
    "api/intake/analyze.mjs": { "maxDuration": 60 },
    "api/intake/transcribe.mjs": { "maxDuration": 60 }
  },
  "headers": [
    {
      "source": "/api/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "no-store" },
        { "key": "X-Content-Type-Options", "value": "nosniff" }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        { "key": "Content-Security-Policy", "value": "default-src 'self'; script-src 'self' https://www.google.com/recaptcha/ https://www.gstatic.com/recaptcha/; style-src 'self' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; connect-src 'self' https://www.google.com/recaptcha/; frame-src https://www.google.com/recaptcha/ https://recaptcha.google.com/recaptcha/; img-src 'self' data:; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'self'" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Permissions-Policy", "value": "camera=(), geolocation=(), microphone=(self)" },
        { "key": "X-Content-Type-Options", "value": "nosniff" }
      ]
    }
  ]
}
