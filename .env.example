# Server-side development configuration. Copy to .env.local and add your own key.
# Never commit .env.local or expose this value through VITE_* variables.
OPENAI_API_KEY=
AOC_INTAKE_MODEL=gpt-5.4
AOC_AI_ORGANIZER_ENABLED=false
# Live speech-to-text; company key stays server-side. Enable separately for production.
AOC_VOICE_ENABLED=false
# Obvious description typos only; uncertain wording requires client review.
AOC_DESCRIPTION_CORRECTION_ENABLED=false

# Entry screen. Enable browser and server flags together in the deployment environment.
VITE_AOC_ACCESS_GATE_ENABLED=false
AOC_ACCESS_GATE_ENABLED=false
# JSON array of business emails manually approved by AOC. Never commit real approvals.
AOC_APPROVED_EMAILS=[]
# Random server-side secret of at least 32 characters. Never use a VITE_ prefix.
AOC_ACCESS_SESSION_SECRET=
AOC_ACCESS_SESSION_HOURS=8

# Server-only access-request storage. Disabled until schema and tests are ready.
# Keep these credentials OUT of VITE_* variables and browser code.
AOC_ACCESS_REQUESTS_ENABLED=false
# Optional review mode: pending request -> AOC approval -> private invitation.
# Leave false when using submit-and-enter mode.
AOC_MANUAL_ACCESS_ENABLED=false
# Save five details, then continue without email verification or approval.
# Enable deliberately only after server storage and the session secret are configured.
AOC_INTAKE_ONLY_ENABLED=false
# Server-side calculation snapshots linked to the signed intake submission.
# Requires the intake-only and server-gate flags plus configured database storage.
AOC_ESTIMATE_RECORDS_ENABLED=false
SUPABASE_URL=
SUPABASE_SECRET_KEY=
# Legacy fallback only if the project does not provide SUPABASE_SECRET_KEY:
SUPABASE_SERVICE_ROLE_KEY=
