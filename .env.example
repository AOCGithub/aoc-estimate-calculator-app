# Server-side development configuration. Copy to .env.local and add your own key.
# Never commit .env.local or expose this value through VITE_* variables.
OPENAI_API_KEY=
AOC_INTAKE_MODEL=gpt-5.4
AOC_AI_ORGANIZER_ENABLED=false
# Live speech-to-text; company key stays server-side. Enable separately for production.
AOC_VOICE_ENABLED=false
# Obvious description typos only; uncertain wording requires client review.
AOC_DESCRIPTION_CORRECTION_ENABLED=false

# Entry screen. Enable browser and server flags together in the deployment environment.
VITE_AOC_ACCESS_GATE_ENABLED=false
# reCAPTCHA: both keys enable it automatically. Never prefix the secret with VITE_.
VITE_RECAPTCHA_SITE_KEY=
RECAPTCHA_SECRET_KEY=
# Match the key registration: v2 for the visible checkbox; defaults to v3.
# RECAPTCHA_VERSION=v2
# Optional rollback/local-test override. Leave unset to follow configured keys.
# AOC_RECAPTCHA_ENABLED=false
# RECAPTCHA_MIN_SCORE=0.5
AOC_ACCESS_GATE_ENABLED=false
# JSON array of business emails manually approved by AOC. Never commit real approvals.
AOC_APPROVED_EMAILS=[]
# Random server-side secret of at least 32 characters. Never use a VITE_ prefix.
AOC_ACCESS_SESSION_SECRET=
AOC_ACCESS_SESSION_HOURS=8

# Server-only access-request storage. Disabled until schema and tests are ready.
# Keep these credentials OUT of VITE_* variables and browser code.
AOC_ACCESS_REQUESTS_ENABLED=false
# Optional review mode: pending request -> AOC approval -> private invitation.
# Leave false when using submit-and-enter mode.
AOC_MANUAL_ACCESS_ENABLED=false
# Save five details, then continue without email verification or approval.
# Enable deliberately only after server storage and the session secret are configured.
AOC_INTAKE_ONLY_ENABLED=false
# Server-side calculation snapshots linked to the signed intake submission.
# Requires the intake-only and server-gate flags plus configured database storage.
AOC_ESTIMATE_RECORDS_ENABLED=false
# Optional reusable company profiles. Requires the server gate, intake-only mode,
# Supabase migration and server key. Consent is separate from estimate recording.
AOC_CLIENT_PROFILES_ENABLED=false
AOC_CLIENT_PROFILE_TTL_DAYS=30
# Protects daily expiry cleanup. Random secret, at least 32 characters; server only.
CRON_SECRET=
# Offline SQLite adapter for npm run dev:profiles only; never enable on Vercel.
AOC_LOCAL_CLIENT_PROFILES_ENABLED=false
SUPABASE_URL=
SUPABASE_SECRET_KEY=
# Legacy fallback only if the project does not provide SUPABASE_SECRET_KEY:
SUPABASE_SERVICE_ROLE_KEY=

# G2 Stripe sandbox. Both feature flags default to off.
# Put the sandbox key and webhook secret in .env.stripe.local (Git-ignored).
# Use an AOC sandbox and sk_test_ key; checkout uses the reviewed audit quote.
AOC_STRIPE_TEST_HANDOFF_ENABLED=false
VITE_AOC_STRIPE_TEST_HANDOFF_ENABLED=false
STRIPE_SECRET_KEY=
# Local: Stripe CLI listener secret. Hosted: signing secret for the HTTPS sandbox endpoint.
STRIPE_WEBHOOK_SECRET=
# Hosted only: exact HTTPS origin, such as https://estimate.alwaysopencommerce.com (no trailing slash).
AOC_G2_HOSTED_ORIGIN=
# Optional dedicated server-side database connection. Falls back to POSTGRES_URL.
AOC_G2_POSTGRES_URL=

# G2 sandbox payment confirmations. Server-side settings only.
AOC_G2_PAYMENT_EMAILS_ENABLED=false
AOC_G2_EMAIL_FROM=
# Defaults to microsoft365 on Vercel and smtp in local development.
AOC_G2_EMAIL_PROVIDER=
AOC_G2_MS_TENANT_ID=
AOC_G2_MS_CLIENT_ID=
AOC_G2_MS_MAILBOX_ID=
AOC_G2_MS_CLIENT_SECRET=
# Local SMTP capture settings.
AOC_G2_SMTP_HOST=
AOC_G2_SMTP_PORT=587
AOC_G2_SMTP_USER=
AOC_G2_SMTP_PASSWORD=
# `npm run dev:g2:email` requires the provider secret locally because Vercel
# intentionally does not export secret values. Keep it in ignored .env.local.
# Optional: route client copies to an internal tester during sandbox testing.
AOC_G2_EMAIL_TEST_CLIENT_TO=
