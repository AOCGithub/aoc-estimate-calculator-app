# Server-side development configuration. Copy to .env.local and add your own key.
# Never commit .env.local or expose this value through VITE_* variables.
OPENAI_API_KEY=
AOC_INTAKE_MODEL=gpt-5.4
AOC_AI_ORGANIZER_ENABLED=false

# Phase 2 gated entry. Keep both flags false until AOC has approved at least one tester.
VITE_AOC_ACCESS_GATE_ENABLED=false
AOC_ACCESS_GATE_ENABLED=false
# JSON array of business emails manually approved by AOC. Never commit real approvals.
AOC_APPROVED_EMAILS=[]
# Random server-side secret of at least 32 characters. Never use a VITE_ prefix.
AOC_ACCESS_SESSION_SECRET=
AOC_ACCESS_SESSION_HOURS=8
