{
  "name": "aoc-ai-commerce-estimator",
  "private": true,
  "version": "1.0.0",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "vite build",
    "build:worker": "npm run build && node scripts/build-worker.cjs",
    "preview": "vite preview --host 0.0.0.0",
    "test:domain": "node tests/test-journey.cjs && node tests/test-commercial.cjs",
    "test:worker": "node tests/test-journey-worker.cjs",
    "test:intake": "node tests/test-voice-server.cjs",
    "test:vercel": "node tests/test-vercel-api.mjs",
    "test:access": "node tests/test-access.mjs",
    "test:access-ui": "node tests/test-access-ui.cjs",
    "test:ui": "node tests/test-react-ui.cjs",
    "test:ui:capture": "node tests/test-react-ui.cjs --capture",
    "test": "npm run build:worker && npm run test:access && npm run test:access-ui && npm run test:domain && npm run test:worker && npm run test:intake && npm run test:vercel && npm run test:ui && node scripts/validate-artifact.mjs"
  },
  "dependencies": {
    "@vercel/speed-insights": "^2.0.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.4",
    "playwright-core": "^1.64.1",
    "vite": "^6.1.0"
  }
}
